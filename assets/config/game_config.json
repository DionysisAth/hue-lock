{
  "_comment": "All gameplay tuning lives here (design doc 7 and 14.3). Angles are in degrees, times in milliseconds. 'level' = rounds cleared in the current run.",

  "timing": {
    "graceMs": 22,
    "perfectFraction": 0.2,
    "perfectMinWindowMs": 34,
    "nearMissMs": 90,
    "minReactionMs": 380,
    "splitSecondLeadMs": 650,
    "firstRoundLeadMs": 650,
    "ruleChangeLeadMs": 600,
    "minZoneWindowMs": 75,
    "maxTapLookbackMs": 120,
    "deathFreezeMs": 380,
    "restartLockoutMs": 120,
    "continueCountdownMs": 1200
  },

  "oneLap": {
    "_comment": "The target must be hit on the pointer's first fair pass; a fuse around the ball shows the time left.",
    "enabled": true
  },

  "pointer": {
    "baseSpeedDegPerSec": 115,
    "speedPerLevel": 1.8,
    "maxSpeedDegPerSec": 270
  },

  "zone": {
    "startSizeDeg": 58,
    "sizePerLevel": -0.4,
    "minSizeDeg": 20,
    "otherZoneSizeFactor": 1.0,
    "minGapDeg": 9,
    "decoyGapDeg": [4, 9],
    "maxLeadFraction": 0.85
  },

  "wave": {
    "period": 6,
    "breatherLevelDrop": 7
  },

  "stages": [
    { "fromLevel": 0,  "name": "warmup",    "colors": [1, 1], "locks": [1, 1], "reverse": 0.0, "decoys": 0, "rotate": 0.0, "bonus": 0.0,  "inverted": 0.0,  "split": 0.0,  "ghost": 0.0,  "pulse": 0.0, "hold": 0 },
    { "fromLevel": 8,  "name": "two-color", "colors": [2, 2], "locks": [1, 2], "reverse": 0.0, "decoys": 0, "rotate": 0.0, "bonus": 0.2,  "inverted": 0.0,  "split": 0.0,  "ghost": 0.0,  "pulse": 0.0, "hold": 0 },
    { "fromLevel": 16, "name": "reverse",   "colors": [2, 3], "locks": [2, 3], "reverse": 1.0, "decoys": 0, "rotate": 0.0, "bonus": 0.2,  "inverted": 0.0,  "split": 0.0,  "ghost": 0.0,  "pulse": 0.0, "hold": 0.15 },
    { "fromLevel": 26, "name": "not",       "colors": [3, 4], "locks": [2, 3], "reverse": 0.7, "decoys": 1, "rotate": 0.0, "bonus": 0.2,  "inverted": 0.25, "split": 0.0,  "ghost": 0.0,  "pulse": 0.0, "hold": 0.15 },
    { "fromLevel": 36, "name": "spin",      "colors": [3, 4], "locks": [2, 4], "reverse": 0.6, "decoys": 1, "rotate": 0.8, "bonus": 0.2,  "inverted": 0.15, "split": 0.0,  "ghost": 0.3,  "pulse": 0.0, "hold": 0.15 },
    { "fromLevel": 48, "name": "split",     "colors": [2, 4], "locks": [2, 4], "reverse": 0.6, "decoys": 1, "rotate": 0.5, "bonus": 0.2,  "inverted": 0.15, "split": 0.3,  "ghost": 0.2,  "pulse": 0.0, "hold": 0.12 },
    { "fromLevel": 60, "name": "veteran",   "colors": [2, 4], "locks": [2, 4], "reverse": 0.6, "decoys": 1, "rotate": 0.4, "bonus": 0.2,  "inverted": 0.15, "split": 0.2,  "ghost": 0.2,  "pulse": 0.0, "hold": 0.15 },
    { "fromLevel": 75, "name": "chaos",     "colors": [2, 4], "locks": [3, 5], "reverse": 0.5, "decoys": 1, "rotate": 0.5, "bonus": 0.25, "inverted": 0.2,  "split": 0.2,  "ghost": 0.25, "pulse": 0.0, "hold": 0.15 }
  ],

  "ringRotation": {
    "minFractionOfPointer": 0.12,
    "maxFractionOfPointer": 0.32
  },

  "pulse": {
    "_comment": "Surge (pointer speed swings by +/- amplitude) is off: no stage or level uses it (stage 'pulse' chance 0).",
    "amplitude": 0.45,
    "periodMs": 900
  },

  "ghost": {
    "_comment": "Blinking starts visible at the start of the round, so the target is always seen first.",
    "periodMs": 1200,
    "visibleFraction": 0.62
  },

  "announce": {
    "_comment": "Only boss rounds (and a shield save) freeze the run. NOT / split rounds show a banner and start their target at least timing.ruleChangeLeadMs ahead instead; new mechanics get a banner (Levels mode teaches them).",
    "shieldMs": 1000
  },

  "bonusZone": {
    "_comment": "Greedy zone: a thin extra zone of the ball's color, worth more.",
    "sizeDeg": 8,
    "minWindowMs": 45,
    "points": 5
  },

  "locks": {
    "_comment": "A set of N locks in a row; clearing the set pays this much per lock.",
    "setBonusPerLock": 1
  },

  "fever": {
    "perfectStreak": 5,
    "pointsMultiplier": 2,
    "speedFactor": 1.12
  },

  "focus": {
    "_comment": "Perfects (and a little from Goods) fill the Focus meter; the Focus button spends it to run the game at timeScale. Drain is per real second.",
    "timeScale": 0.55,
    "perPerfect": 0.2,
    "perGood": 0.05,
    "drainPerSecond": 0.4,
    "minToStart": 0.25
  },

  "hold": {
    "_comment": "Hold rounds: the target is a long zone swept in minMs..maxMs. Press in it, hold, and let go within perfectWindowMs of its end for a Perfect; letting go before minHeldFraction of it is a miss, holding past its end is a Good.",
    "minMs": 450,
    "maxMs": 750,
    "maxDeg": 110,
    "perfectWindowMs": 90,
    "minHeldFraction": 0.5
  },

  "rush": {
    "_comment": "Rush mode: no game over; a miss costs time, a Perfect adds a little.",
    "seconds": 60,
    "missPenaltySeconds": 5,
    "perfectBonusSeconds": 0.5
  },

  "powerUps": {
    "chance": 0.08,
    "minLevel": 8,
    "slowRounds": 4,
    "slowFactor": 0.75,
    "wideRounds": 5,
    "wideFactor": 1.5
  },

  "boss": {
    "_comment": "Memory round every N levels: watch the color sequence, then hit it in order. Beating one in Endless, Daily or a duel offers a choice of three perks.",
    "every": 15,
    "sequenceLength": [3, 4],
    "introMs": 1600,
    "previewPerColorMs": 1000,
    "previewGapMs": 250,
    "goDelayMs": 900,
    "zoneSizeDeg": 34,
    "speedFactor": 0.85,
    "stepPoints": 3,
    "clearBonus": 10
  },

  "worlds": {
    "_comment": "Every N levels the stage changes: background tint, banner, faster music.",
    "every": 20,
    "tempoStep": 0.04,
    "maxTempo": 1.2
  },

  "scoring": {
    "goodPoints": 1,
    "perfectPoints": 3,
    "perfectsPerMultiplierStep": 3,
    "maxMultiplier": 5
  },

  "coins": {
    "scorePerCoin": 12,
    "coinZoneChance": 0.08,
    "coinZoneMinLevel": 5,
    "coinZoneBonus": 5
  },

  "continue": {
    "maxPerRun": 1,
    "coinCost": 120
  },

  "ads": {
    "interstitialEveryRuns": 4,
    "noAdsFirstRuns": 3
  }
}
